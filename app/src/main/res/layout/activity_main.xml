<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:id="@+id/main_layout"
    tools:context=".MainActivity">

    <!-- Top Action Bar with Menu Icon -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#1E1E1E">

        <ImageView
            android:id="@+id/btn_menu"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:contentDescription="Menu" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ruu VPN"
            android:textColor="#00E5FF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Add Config Button (+) -->
        <TextView
            android:id="@+id/btn_add_config"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="+"
            android:textColor="#00E5FF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Sub Header Tabs -->
    <LinearLayout
        android:id="@+id/sub_header"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_below="@id/top_bar"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#1E1E1E">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Saved Configs List"
            android:textColor="#00E5FF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Hidden EditText -->
    <EditText
        android:id="@+id/v2ray_config"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/sub_header"
        android:background="@android:color/transparent"
        android:textColor="@android:color/transparent"
        android:visibility="gone" />

    <!-- Main Content Scroll Area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/sub_header"
        android:layout_above="@id/bottom_status_bar"
        android:padding="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Currently Connected / Active Server Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1E1E1E"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACTIVE SERVER"
                    android:textColor="#00E5FF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/connection_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="connection mode : VPN_MODE"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/connected_server_delay"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="delay : tap to test"
                        android:textColor="#AAAAAA"
                        android:textSize="12sp" />

                    <!-- Ping Test Button -->
                    <Button
                        android:id="@+id/server_delay"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:backgroundTint="#2C2C2C"
                        android:text="Ping Test"
                        android:textColor="#00E5FF"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/connection_duration"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="time: 00:00:00"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/connection_speed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 B/s | 0 B/s"
                        android:textColor="#00E5FF"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/connection_traffic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="traffic: 0 B | 0 B"
                    android:textColor="#888888"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/config_preview_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <!-- Container for Dynamic Config List Items -->
            <LinearLayout
                android:id="@+id/config_list_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Status Bar -->
    <LinearLayout
        android:id="@+id/bottom_status_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_alignParentBottom="true"
        android:background="#1E1E1E"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Disconnected"
            android:textColor="#888888"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Bottom-Right Round Connect / Stop Button -->
    <Button
        android:id="@+id/btn_connection"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="#00E5FF"
        android:text="▶"
        android:textColor="#121212"
        android:textSize="22sp" />

</RelativeLayout>
